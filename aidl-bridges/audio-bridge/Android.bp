cc_binary {
    name: "ubtouch-audio-bridge",
    vendor: true,

    srcs: [
        "src/main.cpp",
        "src/audio_proxy.cpp",
    ],

    local_include_dirs: [
        "../common",
        "src",
    ],

    shared_libs: [
        "libbase",
        "liblog",
        "libutils",
        "libbinder_ndk",
        "android.hardware.audio.core-V1-ndk",
        "android.hardware.audio.common-V1-ndk",
    ],

    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-std=c++17",
        "-O2",
    ],

    init_rc: ["ubtouch-audio-bridge.rc"],
}
