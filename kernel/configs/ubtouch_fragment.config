# ==============================================================================
# Ubuntu Touch / Halium Kernel Configuration Fragment
# Target Device: Google Pixel 7 (panther / pantah) - SoC: Google Tensor G2 (gs201)
# Base Kernel: Linux 5.10 GKI 2.0 (Common AOSP)
# ==============================================================================
#
# Этот конфигурационный фрагмент содержит обязательные параметры ядра Linux,
# необходимые для корректного запуска контейнеров LXC, изоляции AppArmor,
# графического стека Mir/Lomiri и межпроцессного взаимодействия через Binder/libhybris.
#

# ------------------------------------------------------------------------------
# 1. Namespaces (Пространства имен для LXC и контейнеризации Halium)
# ------------------------------------------------------------------------------
# Halium запускает сервисы Android внутри изолированного LXC-контейнера.
# Для этого ядро обязано поддерживать все стандартные пространства имен Linux.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# ------------------------------------------------------------------------------
# 2. Control Groups (cgroups v1 & v2 для управления ресурсами и изоляции)
# ------------------------------------------------------------------------------
# Ubuntu Touch (systemd) и LXC требуют cgroups для ограничения ресурсов,
# заморозки приложений в фоне (cgroup freezer) и контроля иерархий процессов.
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_PROC_PID_CPUSET=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_MEMCG=y
CONFIG_MEMCG_SWAP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_CGROUP=y

# ------------------------------------------------------------------------------
# 3. Security, Auditing & AppArmor (Безопасность и политики доступа Ubuntu)
# ------------------------------------------------------------------------------
# Ubuntu Touch использует AppArmor для песочницы приложений (Click packages / Lomiri).
# Без AppArmor запуск пользовательских приложений и сервисов Ubuntu блокируется.
CONFIG_SECURITY=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_BOOTPARAM_VALUE=1
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_INTEGRITY=y

# ------------------------------------------------------------------------------
# 4. Android IPC / Binder & BinderFS (Межпроцессное взаимодействие libhybris)
# ------------------------------------------------------------------------------
# Для Android 13 и Halium 13 необходим BinderFS с узлами binder, hwbinder, vndbinder.
# Через них libhybris взаимодействует с аппаратными HAL-сервисами (AIDL / HIDL).
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# ------------------------------------------------------------------------------
# 5. Filesystems & Storage (Файловые системы для rootfs и оверлеев)
# ------------------------------------------------------------------------------
# Поддержка devtmpfs для монтирования /dev до старта systemd,
# devpts для виртуальных терминалов (SSH/терминал Lomiri),
# squashfs и overlayfs для работы неизменяемого системного образа rootfs.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_MULTI=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_OVERLAY_FS=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# ------------------------------------------------------------------------------
# 6. Networking & Container Bridge (Сетевой стек, мост LXC и фаервол)
# ------------------------------------------------------------------------------
# Виртуальный интерфейс veth и сетевой мост bridge требуются для связи хоста
# Ubuntu Touch с сервисами Android (RIL, Wi-Fi daemon, GPS).
CONFIG_NET=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_REJECT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NETFILTER_XT_MATCH_COMMENT=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_TUN=y

# ------------------------------------------------------------------------------
# 7. Memory Optimization & ZRAM (Подкачка и сжатие оперативной памяти)
# ------------------------------------------------------------------------------
# ZRAM критически важен на мобильных ОС для предотвращения принудительного
# завершения приложений из-за OOM (Out Of Memory).
CONFIG_SWAP=y
CONFIG_ZRAM=y
CONFIG_ZRAM_WRITEBACK=y

# ------------------------------------------------------------------------------
# 8. Input, DRM & USB Gadget (Дисплей, сенсорный ввод и режим отладки)
# ------------------------------------------------------------------------------
# Поддержка ввода evdev/uinput для тачскрина Pixel 7 и эмуляции кнопок.
# RNDIS и ACM для сетевого подключения по USB и telnet/ssh отладки на этапе загрузки.
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y
